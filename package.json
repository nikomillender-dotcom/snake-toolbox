{
  "name": "snake-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Snake ToolBox: Niko's iPad-first Pyodide PWA for Python mastery. Integrated build (Lysithea frontend + Hubert engine).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker-guard": "node scripts/worker-boundary-guard.mjs",
    "postinstall": "node scripts/copy-pyodide-assets.mjs",
    "no-mock-guard": "node scripts/no-mock-in-prod-guard.mjs",
    "lint:dash": "python \"C:/Users/meowr/OneDrive/Documents/sub-agents/tools/dash_guard.py\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "codemirror": "^6.0.1",
    "preact": "^10.24.3",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "pyodide": "314.0.2",
    "typescript": "7.0.2",
    "vite": "^5.4.10",
    "vitest": "^4.1.10"
  }
}
